# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here-change-in-production

# Database — Neon: usar connection pooler na app (serverless) e URL direta para migrate/db push
# Pooled (ep-xxx-pooler.*)
DATABASE_URL="postgresql://user:senha@ep-xxx-pooler.region.aws.neon.tech/shopmy?sslmode=require"
# Direct / unpooled (ep-xxx.* sem -pooler) — obrigatório no schema Prisma (pode ser igual em CI/Postgres local)
DATABASE_URL_UNPOOLED="postgresql://user:senha@ep-xxx.region.aws.neon.tech/shopmy?sslmode=require"

# Opcional: Data API REST do Neon (não é usada pelo Prisma — só integrações HTTP)
# NEON_REST_API_URL=https://ep-xxx.apirest.region.aws.neon.tech/shopmy/rest/v1

# Stripe (opcional - para pagamentos)
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key_here
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
