# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here-change-in-production

# Database (Neon / PostgreSQL — use sslmode=require em produção)
# Exemplo Neon: postgresql://user:senha@ep-xxx.region.aws.neon.tech/shopmy?sslmode=require
DATABASE_URL="postgresql://user:senha@localhost:5432/shopmy?schema=public"

# Stripe (opcional - para pagamentos)
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key_here
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
